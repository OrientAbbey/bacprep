{
  "id": "facture-electricite-energie",
  "titre": "Énergie électrique et coût mensuel d'un appareil",
  "matiere": "Physique-Chimie",
  "classes": [
    "3e",
    "2nde"
  ],
  "chapitre": "Énergie électrique",
  "difficulte": 1,
  "variables": {
    "pw": {
      "choix": [
        1000,
        1200,
        1500,
        2000
      ]
    },
    "h": {
      "decimal": [
        0.5,
        4,
        0.5
      ]
    },
    "tarif": {
      "choix": [
        50,
        60,
        70,
        80
      ]
    },
    "app": {
      "entier": [
        0,
        3
      ]
    }
  },
  "calculs": {
    "pkw": "pw/1000",
    "ej": "pw*h/1000",
    "em": "ej*30",
    "cout": "em*tarif"
  },
  "enonce": "{{texte(app, \"Un fer à repasser\", \"Une bouilloire électrique\", \"Un chauffe-eau électrique\", \"Un four électrique\")}} de puissance $P = {{pw}}\\ \\mathrm{W}$ fonctionne $t = {{decimal(h)}}\\ \\mathrm{h}$ par jour. Le fournisseur d'électricité facture le kWh à {{tarif}} FCFA (tarif donné à titre d'exemple). On compte un mois de 30 jours.",
  "questions": [
    {
      "enonce": "Calculer l'énergie électrique consommée en une journée, en kWh.",
      "reponse": "$E_j = {{decimal(ej)}}\\ \\mathrm{kWh}$",
      "etapes": "$E = P \\times t$ avec $P = {{decimal(pkw)}}\\ \\mathrm{kW}$ : $E_j = {{decimal(pkw)}} \\times {{decimal(h)}} = {{decimal(ej)}}\\ \\mathrm{kWh}$.",
      "points": 1
    },
    {
      "enonce": "En déduire l'énergie consommée en 30 jours.",
      "reponse": "$E = {{decimal(em)}}\\ \\mathrm{kWh}$",
      "etapes": "$E = 30 \\times E_j = 30 \\times {{decimal(ej)}} = {{decimal(em)}}\\ \\mathrm{kWh}$.",
      "points": 1
    },
    {
      "enonce": "Calculer le coût de cette consommation pour 30 jours.",
      "reponse": "${{milliers_tex(cout)}}\\ \\mathrm{FCFA}$",
      "etapes": "Coût $= {{decimal(em)}} \\times {{tarif}} = {{milliers_tex(cout)}}\\ \\mathrm{FCFA}$.",
      "points": 2
    }
  ]
}
