# Environnement : dev (défaut) | prod. En prod : cookie de session Secure,
# ADMIN_TOKEN d'exemple refusé. Positionné à prod dans render.yaml.
ENV=dev

# --- Assistant IA ---
GEMINI_API_KEY=
# Modèles Gemini GRATUITS, fallback ORDONNÉ : on essaie la liste dans cet
# ordre, un échec (quota 429, indisponibilité…) passe au modèle suivant
# avant de basculer sur Groq puis le mode démo.
#   gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.6-flash,
#   gemini-3.8-flash, gemini-3.7-flash, gemma-4-26b-a4b-it, gemma-4-31b-it
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.6-flash,gemini-3.8-flash
GROQ_API_KEY=
# Modèles Groq GRATUITS, fallback ordonné (même mécanique que Gemini) :
#   openai/gpt-oss-20b, qwen/qwen3.6-27b, qwen/qwen3.8-27b, openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-20b,qwen/qwen3.6-27b,openai/gpt-oss-120b,qwen/qwen3.8-27b
LLM_CONCURRENCY_LIMIT=5

# --- Administration ---
# Jeton partagé du back-office : CHANGER la valeur d'exemple, le serveur
# refuse "admin123" quand ENV=prod. ADMIN_EMAILS : liste blanche CSV.
ADMIN_TOKEN=admin123
ADMIN_EMAILS=admin@example.com
# Déconnexion admin automatique : délai après lequel le verrou expire
# UNE FOIS LA PAGE /admin QUITTÉE (la console envoie un battement de cœur
# toutes les 30 s tant qu'elle est ouverte — un admin restant sur la page
# n'est jamais déconnecté).
ADMIN_SESSION_TIMEOUT_MINUTES=3

# --- Authentification élève ---
# mock : formulaire simulé (démo/dev) | google : Google Identity Services.
# En mode google, /api/auth/mock-login est REFUSÉ côté serveur.
AUTH_MODE=mock
GOOGLE_CLIENT_ID=

# Fonctionnalités de démonstration (mock-login, paiement simulé) :
# autorisées hors production ; en ENV=prod elles sont refusées SAUF si ce
# flag est posé explicitement (démo publique hébergée, cf. render.yaml).
DEMO_MODE=

# Clé HMAC des URLs signées de fichiers (/api/files/{id}?token=...).
# GÉNÉRER une valeur aléatoire (ex. python -c "import secrets; print(secrets.token_hex(32))").
# Sinon dérivée d'ADMIN_TOKEN (fonctionne, mais un secret dédié est préférable).
FILE_URL_SECRET=

# Documentation OpenAPI (/docs, /redoc, /openapi.json) : publique en dev.
# En ENV=prod, servie à un chemin secret (ex. "api-docs-9f2k" → /api-docs-9f2k) ;
# vide ou absent = docs désactivées. Voir DEPLOIEMENT.md.
DOCS_PATH=

# Base de données : SQLite en développement local, PostgreSQL en production
# (ex. Supabase — voir DEPLOIEMENT.md). SQLite ne stocke que les métadonnées,
# jamais les fichiers d'épreuves.
# Supabase : utiliser le POOLER Supavisor (port 6543, IPv4) — la connexion
# directe db.<ref>.supabase.co:5432 est IPv6-only et non routable depuis Render.
#   DATABASE_URL=postgresql://postgres.<project_ref>:<mdp>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Un sslmode=require est ajouté automatiquement (surcharge via DB_SSLMODE).
# DATABASE_URL=postgresql://user:password@host:5432/bacprep
# DB_SSLMODE=require
# DB_POOL_SIZE=5
# DB_POOL_MAX_OVERFLOW=10

# Stockage des fichiers d'épreuves (Markdown + images) — contenu dans un
# bucket objet, jamais en base.
# local : développement — fichiers sous backend/data/storage/
# s3    : production — stockage S3-compatible piloté par les variables
#         STORAGE_* ci-dessous (Tigris Data par défaut ; Supabase Storage et
#         Backblaze B2 fonctionnent à l'identique en changeant endpoint/région).
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=backend/data/storage

# --- Configuration S3-compatible (STORAGE_BACKEND=s3) ---
# Le bucket (PRIVÉ) doit exister avant le premier démarrage.
#
# Tigris Data (défaut prod) :
#   STORAGE_ENDPOINT_URL=https://fly.storage.tigris.dev
#   STORAGE_REGION=auto
# Supabase Storage :
#   STORAGE_ENDPOINT_URL=https://<project_ref>.supabase.co/storage/v1/s3
#   STORAGE_REGION=<région du projet, ex. eu-central-1>
#   (clés S3 créées dans Project Settings → Storage → S3 Access Keys)
# Backblaze B2 :
#   STORAGE_ENDPOINT_URL=https://s3.<region>.backblazeb2.com  (région du bucket)
#   STORAGE_REGION=<région du bucket, ex. eu-central-003>
#   (clés = Application Key avec accès lecture/écriture)
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_SIGNED_URL_EXPIRY=900

# Origines autorisées pour le frontend (CORS), séparées par des virgules.
# En production avec service unifié (backend + frontend/dist), laisser vide.
CORS_ORIGINS=http://localhost:5173

# Zone d'import massif locale (dossier organisé {annee}/{classe}/{matiere}/)
IMPORTS_DIR=backend/data/imports
